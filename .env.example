NODE_ENV=development
LOG_LEVEL=info
PORT=9080

# Restate
RESTATE_RUNTIME_URL=http://localhost:18080
RESTATE_ADMIN_URL=http://localhost:19070
RESTATE_AUTH_TOKEN=
RESTATE_IDENTITY_KEYS=
PUBLIC_RESTATE_ENDPOINT=http://localhost:9080/restate

# MongoDB
MONGODB_URI=mongodb://localhost:27017/appointments
MONGODB_DB_NAME=

# Redis
REDIS_URL=redis://localhost:6379
QUEUE_DASHBOARD_PATH=/admin/queues

# Email queue (BullMQ)
EMAIL_QUEUE_NAME=appointment-email
EMAIL_WORKER_CONCURRENCY=100
EMAIL_RATE_MAX=100
EMAIL_RATE_DURATION_MS=1000
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=500
EMAIL_JOB_REMOVE_COMPLETE_AGE_SECONDS=86400
EMAIL_JOB_REMOVE_COMPLETE_COUNT=10000
EMAIL_JOB_REMOVE_FAIL_AGE_SECONDS=604800

# Reminder timing
REMINDER_BEFORE_MS=60000
REMINDER_AFTER_MS=60000

# Maintenance queue
MAINTENANCE_QUEUE_NAME=appointment-maintenance
CLEANUP_EVERY_MS=3600000
CLEANUP_GRACE_MS=86400000
CLEANUP_LIMIT=10000

# Kafka / Redpanda
KAFKA_CLIENT_ID=appointment-service
KAFKA_BROKERS=localhost:19092
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_APPOINTMENT_TOPIC=appointment-events
KAFKA_ANALYTICS_GROUP_ID=appointment-analytics
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# SendGrid (for production email delivery)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
