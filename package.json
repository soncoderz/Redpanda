{
  "name": "redpanda-appointment-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:app": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "worker:email:dev": "tsx watch scripts/email.worker.ts",
    "worker:email": "node dist/scripts/email.worker.js",
    "worker:maintenance:dev": "tsx watch scripts/maintenance.worker.ts",
    "worker:maintenance": "node dist/scripts/maintenance.worker.js",
    "consumer:analytics:dev": "tsx watch scripts/analytics.consumer.ts",
    "consumer:analytics": "node dist/scripts/analytics.consumer.js",
    "consumer:telegram:dev": "tsx watch scripts/telegram.consumer.ts",
    "consumer:telegram": "node dist/scripts/telegram.consumer.js",
    "consumer:chat:dev": "tsx watch scripts/chat.consumer.ts",
    "consumer:chat": "node dist/scripts/chat.consumer.js",
    "restate:register": "tsx scripts/register-restate.ts",
    "queue:clear": "tsx scripts/clear-queue.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/hono": "^7.0.0",
    "@hono/node-server": "^2.0.2",
    "@restatedev/restate-sdk": "^1.14.2",
    "@restatedev/restate-sdk-clients": "^1.14.2",
    "@sendgrid/mail": "^8.1.6",
    "bullmq": "^5.76.6",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.6.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
