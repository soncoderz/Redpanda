{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chat-message",
  "title": "ChatMessage",
  "description": "Chat message publish lên Kafka topic chat-messages",
  "type": "object",
  "required": ["id", "roomId", "from", "text", "sentAt"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "UUID duy nhất cho mỗi message"
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "description": "ID phòng chat"
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "description": "Tên người gửi"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Nội dung message"
    },
    "sentAt": {
      "type": "string",
      "description": "ISO 8601 timestamp khi gửi"
    }
  },
  "additionalProperties": false
}
